# ---- Site
NEXT_PUBLIC_SITE_URL=https://www.stamp2go.co.il

# ---- Old WordPress media origin (fallback until `npm run media:download` has been run)
WP_MEDIA_ORIGIN=https://www.stamp2go.co.il

# ---- E-mail (Resend) – order notifications to the studio and customers
RESEND_API_KEY=
MAIL_FROM="Stamp2Go <orders@stamp2go.co.il>"
ORDERS_EMAIL_TO=mira@stamp2go.co.il

# ---- Database (Neon Postgres) – orders, production files and contact leads.
# Set automatically by the Vercel ↔ Neon integration. Tables (s2g_*) are created on first use.
DATABASE_URL=

# ---- Alternative: Supabase (used only when DATABASE_URL is not set)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=production-files

# ---- Staff access
ADMIN_PASSWORD=
PRODUCTION_PASSWORD=
ADMIN_SECRET=            # long random string for signing staff cookies

# ---- AI design assistant (optional – falls back to a local rule-based parser)
ANTHROPIC_API_KEY=

# ---- Payments (manual until a clearing provider is chosen)
MANUAL_PAYMENT_AUTO_PRODUCTION=true
# PRICING_COUPONS='[{"code":"WELCOME10","type":"percent","value":10}]'
